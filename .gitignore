# local env files — `.env` holds the Supabase project URL and publishable key
# and must never be committed. `.env.example` is the committed template.
.env
.env*.local
# The one-off schema-push secret (the database password). Needed only to apply
# PRD §32's migration, and never read by the app itself.
.env.migration

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Playwright (end-to-end tests)
test-results/
playwright-report/

# The full-size originals for the ingredient pictures. The app ships the
# prepared 256×256 copies in assets/ingredients/ — run
# `node scripts/prepare-ingredient-images.mjs` after adding a picture here.
/images/
