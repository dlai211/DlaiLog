# Copy this file to `.env` and fill in your own Supabase project's values
# (Supabase dashboard → Project Settings → API). `.env` is git-ignored.
#
# Both values are safe to expose in the client bundle — the database is
# protected by its access rules, not by keeping these secret.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
